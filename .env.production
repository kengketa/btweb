# Production build settings. Public values only: anything VITE_* ends up in the site's bundle.
# Must be https — browsers block an http request from the https site.
VITE_BOOKING_ENDPOINT=https://backendv2.brightonedu.com/api/v1/public/leads
# Cloudflare Turnstile public site key (the secret key belongs on the backend only)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFXZ7MxVs4MG8_oz
